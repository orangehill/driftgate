{
    "items_list": {
        "path": "\/api\/items",
        "pathRegex": "{^\/api\/items$}sDu",
        "host": "ANY",
        "hostRegex": "",
        "scheme": "ANY",
        "method": "GET",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "_controller": "App\\Controller\\ItemsController::list"
        },
        "requirements": "NO CUSTOM",
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    },
    "items_show": {
        "path": "\/api\/items\/{id}",
        "pathRegex": "{^\/api\/items\/(?P<id>\\d+)$}sDu",
        "host": "ANY",
        "hostRegex": "",
        "scheme": "ANY",
        "method": "GET",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "_controller": "App\\Controller\\ItemsController::show"
        },
        "requirements": {
            "id": "\\d+"
        },
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    },
    "items_create": {
        "path": "\/api\/items",
        "pathRegex": "{^\/api\/items$}sDu",
        "host": "ANY",
        "hostRegex": "",
        "scheme": "ANY",
        "method": "POST",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "_controller": "App\\Controller\\ItemsController::create"
        },
        "requirements": "NO CUSTOM",
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    },
    "search": {
        "path": "\/api\/search\/{term}",
        "pathRegex": "{^\/api\/search(?:\/(?P<term>[^\/]++))?$}sDu",
        "host": "ANY",
        "hostRegex": "",
        "scheme": "ANY",
        "method": "ANY",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "term": "",
            "_controller": "App\\Controller\\ItemsController::search"
        },
        "requirements": "NO CUSTOM",
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    }
}
